{
  "expo": {
    "name": "Yeni Form",
    "slug": "yeniform",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "yeniform",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d8fc4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yeniform.app",
      "buildNumber": "3",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Görüntülü görüşme ve kalori foto analizi için kamera erişimi gerekir.",
        "NSMicrophoneUsageDescription": "Görüntülü görüşme için mikrofon erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı ve sağlık belgesi yüklemek için galeri erişimi gerekir.",
        "NSPhotoLibraryAddUsageDescription": "Fotoğraf kaydetmek için galeri erişimi gerekir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yeniform.app",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2d8fc4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2d8fc4",
          "ios": {
            "imageWidth": 288
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2d8fc4",
          "sounds": [
            "./assets/sounds/notification.wav"
          ],
          "androidMode": "default",
          "androidCollapsedTitle": "Yeni Form",
          "iosDisplayInForeground": true
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı ve sağlık belgesi yüklemek için galeri erişimi gerekir.",
          "cameraPermission": "Kalori analizi ve profil fotoğrafı için kamera erişimi gerekir."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Görüntülü görüşme ve kalori foto analizi için kamera erişimi gerekir.",
          "microphonePermission": "Görüntülü görüşme için mikrofon erişimi gerekir.",
          "recordAudioAndroid": true
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0799a1b3-4e0a-4d73-9961-918878977fbb"
      }
    },
    "owner": "yeniform"
  }
}
