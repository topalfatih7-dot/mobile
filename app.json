{
  "expo": {
    "name": "Yeni Form",
    "slug": "yeniform",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "yeniform",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yeniform.app"
    },
    "android": {
      "package": "com.yeniform.app",
      "adaptiveIcon": {
        "backgroundColor": "#2d8fc4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2d8fc4",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      "expo-av",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı ve sağlık belgesi yüklemek için galeri erişimi gerekir.",
          "cameraPermission": "Kalori analizi ve profil fotoğrafı için kamera erişimi gerekir."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Görüntülü görüşme ve kalori foto analizi için kamera erişimi gerekir.",
          "microphonePermission": "Görüntülü görüşme için mikrofon erişimi gerekir.",
          "recordAudioAndroid": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
