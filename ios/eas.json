{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "developmentClient": false,
      "env": {
        "APP_VARIANT": "preview"
      },
      "ios": {
        "simulator": false
      }
    },
    "app-store": {
      "extends": "preview",
      "distribution": "store",
      "developmentClient": false,
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "distribution": "store",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {},
    "app-store": {
      "ios": {
        "ascAppId": "6804174849",
        "appleTeamId": "Z69XV3ZNX5",
        "appleId": "info@yeniform.com"
      }
    }
  }
}
