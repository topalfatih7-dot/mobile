# EAS upload ignore — gitignore ile aynı, AMA FCM dosyaları yüklenir.
# Git’e girmez; iOS FCM için EAS prebuild dosyayı görmeli.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

.env
.env*.local

# FCM V1 admin key — Expo credentials'a yüklenir, EAS tarball'a girmez
*firebase-adminsdk*.json
firebase-service-account*.json

# Store listing / kamera dump — IPA’ya girmez
assets/WhatsApp Image *
assets/store/play-phone/

.DS_Store
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

/ios
/android

npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
*.tsbuildinfo

.agents/

.cursor/test-logs/
