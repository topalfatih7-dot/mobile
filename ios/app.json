{
  "expo": {
    "name": "Yeni Form",
    "slug": "yeniform",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "yeniform",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yeniform.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Görüntülü görüşme ve kalori foto analizi için kamera erişimi gerekir.",
        "NSMicrophoneUsageDescription": "Görüntülü görüşme için mikrofon erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı, kalori analizi ve sağlık belgesi yüklemek için galeri erişimi gerekir.",
        "NSBluetoothAlwaysUsageDescription": "Görüntülü görüşmede sesi Bluetooth kulaklığa yönlendirmek için kullanılır.",
        "NSBluetoothPeripheralUsageDescription": "Görüntülü görüşmede sesi Bluetooth kulaklığa yönlendirmek için kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.yeniform.app",
      "adaptiveIcon": {
        "backgroundColor": "#2d8fc4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2d8fc4",
          "ios": {
            "imageWidth": 288
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2d8fc4",
          "androidMode": "default",
          "androidCollapsedTitle": "Yeni Form",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı, kalori analizi ve sağlık belgesi yüklemek için galeri erişimi gerekir.",
          "cameraPermission": "Kalori analizi ve profil fotoğrafı için kamera erişimi gerekir."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Görüntülü görüşme ve kalori foto analizi için kamera erişimi gerekir.",
          "microphonePermission": "Görüntülü görüşme için mikrofon erişimi gerekir.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/withDailyForegroundService",
      "expo-web-browser",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "460ad8b4-c94a-4933-885c-be703befe489"
      }
    },
    "owner": "yeniforms-team"
  }
}
