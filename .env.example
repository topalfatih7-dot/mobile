# Yeni Form — mobil ortam değişkenleri
# Kopyala: cp .env.example .env  → değerleri doldur
# Web VITE_* karşılıkları (docs/rn-migration/01 §6)

# ── Supabase ─────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
# veya legacy:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Site / API ───────────────────────────────────────────
# Vercel serverless `/api/*` tabanı (aynı production URL)
EXPO_PUBLIC_SITE_URL=https://www.yeniform.com

# Opsiyonel admin e-posta override (varsayılan admin@yeniform.com)
# EXPO_PUBLIC_ADMIN_EMAIL=admin@yeniform.com

# Telegram notify — web VITE_TELEGRAM_NOTIFY_SECRET ile AYNI değer (Vercel'den kopyala)
# Boş bırakırsan: sunucuda secret zorunluysa bildirim 401 olur; giriş bozulmaz
# EXPO_PUBLIC_TELEGRAM_NOTIFY_SECRET=

# Telefon doğrulamayı SMS yerine e-posta linki ile zorla (web VITE_PHONE_VERIFY_VIA_EMAIL)
# EXPO_PUBLIC_PHONE_VERIFY_VIA_EMAIL=true

# Google OAuth — Supabase Auth → URL Configuration → Redirect URLs (mevcut web URL'lerini silme):
#   yeniform://**
#   yeniform://auth/callback
#   exp://**
#   http://localhost:8081/auth/callback
# Detay: docs/MOBILE_OAUTH_SETUP.md
