# Yeni Form Mobile — contracts/env-vars.md
# Secret’ları binary’ye koyma. Service role / Stripe secret yok.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# veya: EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

EXPO_PUBLIC_API_BASE_URL=https://www.yeniform.com
# geriye dönük alias (opsiyonel):
# EXPO_PUBLIC_SITE_URL=https://www.yeniform.com

# EXPO_PUBLIC_ADMIN_EMAIL=admin@yeniform.com

# Mobil IAP/RevenueCat kaldırıldı — satın alma web Stripe (/membership).

EXPO_PUBLIC_DAILY_DOMAIN=
# EXPO_PUBLIC_DAILY_ROOM_PREFIX=donusum
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Native auth Turnstile bypass — Vercel YENIFORM_MOBILE_API_SECRET ile birebir.
# Preview APK (Metro yok) için EAS preview environment’a da yazın:
EXPO_PUBLIC_YENIFORM_MOBILE_API_SECRET=

# EXPO_PUBLIC_GA4_ID=
# Telefon doğrulama (web VITE_PHONE_VERIFY_* parity — varsayılan kapalı):
# EXPO_PUBLIC_PHONE_VERIFY_ENABLED=false
# EXPO_PUBLIC_PHONE_VERIFY_VIA_EMAIL=false

# Kalori AI (web VITE_AI_* parity — varsayılan açık; kapatmak için false):
# EXPO_PUBLIC_AI_CHAT_ENABLED=false
# EXPO_PUBLIC_AI_VISION_ENABLED=false

# Sunucu secret’ları mobil binary’ye koyma (Stripe vb. yalnız Vercel).
